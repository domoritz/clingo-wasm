{
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2022",
    "lib": ["es2022", "dom"],
    "types": ["node"],
    "declaration": true,
    "declarationMap": true,
    "esModuleInterop": true
  },
  "include": ["src/**/*.ts"]
}
