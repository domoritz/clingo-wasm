{
  "name": "clingo-wasm",
  "version": "0.6.0",
  "description": "Clingo compiled to WebAssembly",
  "repository": "https://github.com/domoritz/clingo-wasm",
  "author": "Dominik Moritz <domoritz@gmail.com>",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.node.js",
  "jsdelivr": "dist/index.web.js",
  "unpkg": "dist/index.web.js",
  "exports": {
    ".": {
      "node": {
        "types": "./dist/index.node.d.ts",
        "default": "./dist/index.node.js"
      },
      "default": {
        "types": "./dist/index.web.d.ts",
        "default": "./dist/index.web.js"
      }
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build:wasm": "scripts/build.sh",
    "build": "rimraf dist && tsc && cp src/clingo*.js src/clingo*.wasm src/clingo*.d.ts dist",
    "build:all": "npm run build:wasm && npm run build",
    "watch": "tsc --watch",
    "test": "vitest run",
    "copy": "cp src/clingo*.js src/clingo*.wasm examples/js",
    "clean": "rimraf clingo-* lua-* *.tar.gz src/clingo.js src/clingo-mt.js src/clingo.wasm src/clingo-mt.wasm dist",
    "deploy": "npm run copy && gh-pages -d examples",
    "start:examples": "npm run copy && serve examples"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "gh-pages": "^6.3.0",
    "rimraf": "^6.1.3",
    "serve": "^14.2.6",
    "typescript": "^6.0.3",
    "vitest": "^4.0.8"
  }
}
